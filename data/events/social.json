[
  {
    "id": "hermit",
    "text": "An old hermit watches you train and offers to take you as a disciple.",
    "minAge": 12, "minRealm": 1, "weight": 4, "once": true, "if": ["!flag:master"],
    "choices": [
      { "label": "Kneel and accept him as master", "outcomes": [
